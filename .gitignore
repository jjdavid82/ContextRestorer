# Dependencies — reinstalled via `npm install` (npm workspaces hoists most of
# this to the repo root; the odd package-level node_modules/ is a tiny
# workspace-linking artifact, same story).
node_modules/

# TypeScript project-reference build state (`tsc -b`). Safe to delete/rebuild
# anytime; stale/corrupt copies have caused real "app looks broken" confusion
# in this project before (see project_context_restorer_typecheck_gap memory).
*.tsbuildinfo

# Compiled output — regenerated by `npm run typecheck` / `npm run build:ui` /
# `npm run build:desktop` (tsc emits packages/*/dist and apps/desktop/dist;
# tsc's test project references emit dist-test).
dist/
dist-test/

# Next.js static export + its own build cache, and the copy `apps/ui`'s
# postbuild script drops into `apps/desktop/ui` for the Electron app to serve.
apps/ui/out/
apps/ui/.next/
apps/desktop/ui/

# electron-builder output (`npm run package:win`) — the packaged .exe and its
# unpacked staging directory. Multi-hundred-MB; share the built .exe directly,
# don't commit it.
release/

# Test/coverage output, if ever run with coverage enabled.
coverage/

# OS cruft.
.DS_Store
Thumbs.db

# Editor directories (kept out so nobody's personal editor config leaks in;
# add an explicit `!.vscode/extensions.json` later if the team wants to share
# recommended extensions).
.vscode/
.idea/

# Local env overrides, if any are ever introduced — none exist today, but a
# secret dropped into a `.env` file must never be one `git add .` away from
# landing in history.
.env
.env.*

# Local config overrides (`loadConfig` in packages/core/src/config.ts merges
# these in when present) — real OAuth client secrets belong here, never in
# the tracked `config/*.json` files.
config/*.local.json

# Serena MCP server's local project index/cache — machine-local tool state,
# not project source.
.serena/
